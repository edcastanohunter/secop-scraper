# SECOP Radar — configuración de producción.
# Copiar a deploy/.env en el VPS (junto a deploy.sh) y completar. deploy/.env está en .gitignore: nunca commitearlo.
# Las URLs de la API y de Keycloak NO van aquí: se incrustan al compilar (variables del repo en GitHub).

# Tag de la imagen: "latest" o un build de CI como 1.0.42 (rollback manual = fijarlo y re-ejecutar deploy.sh).
WEB_TAG=latest

# OBLIGATORIO. Red externa de nginx proxy manager (NPM), p. ej. npm_default. Debe existir en el mismo
# engine de Podman (`podman network ls`). En NPM, apuntar el dominio a secop-radar.web:8090.
PROXY_NETWORK=
